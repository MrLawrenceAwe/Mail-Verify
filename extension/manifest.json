{
  "manifest_version": 3,
  "name": "Yahoo Code Fill",
  "version": "0.1.1",
  "description": "Retrieve recent Yahoo email verification codes locally and fill them with a click.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find a Yahoo verification code"
  },
  "key": ""
}
