{
  "manifest_version": 3,
  "name": "Mail Verify",
  "version": "0.5.0",
  "description": "Find email codes, account confirmation links and password reset links; fill, open or copy a selected result.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mail Verify \u2014 email codes and links"
  },
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content-entry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inline/code-picker-controller.js",
        "inline/page-coordinator.js",
        "inline/email-link-card-controller.js",
        "inline/email-link-card-view.js",
        "shared/email-link-url.js",
        "shared/reset-link-copy.js",
        "shared/email-link-details.js",
        "shared/mail-types.js",
        "shared/step-text.js",
        "inline/code-picker-view.js",
        "shared/mail-timing.js",
        "shared/polling-lifecycle.js",
        "inline/inline-client.js",
        "shared/code-fields.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
