{
  "manifest_version": 3,
  "name": "Yahoo Code Fill",
  "version": "0.2.4",
  "description": "Show Yahoo verification codes on sign-in pages and fill the selected code with a click.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find a Yahoo verification code"
  },
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content-entry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inline.js",
        "inline-view.js",
        "fill-code.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
